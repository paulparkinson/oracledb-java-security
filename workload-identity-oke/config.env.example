# Non-secret deployment inputs. Replace placeholders; keep real inventory private.
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..REPLACE
OCI_DATABASE_ID=ocid1.autonomousdatabase.oc1.eu-frankfurt-1.REPLACE
DB_JDBC_URL='jdbc:oracle:thin:@tcps://DB_HOST:1522/DB_SERVICE?connect_timeout=15sec&transport_connect_timeout=10sec&retry_count=0'
EXPECTED_DB_USER=OKE_JDBC_DEMO
DEMO_IMAGE=REGISTRY/REPOSITORY@sha256:REPLACE_WITH_DIGEST
TEST_ROUNDS=1
TEST_INTERVAL_SECONDS=0
